# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- OpenRouter LLM Configuration ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_SITE_URL=https://bookingbot.example.com
OPENROUTER_SITE_NAME=BookingBot

# Fallback: OpenAI (if OpenRouter fails)
OPENAI_API_KEY=sk-your-key-here

# ---- Database ----
POSTGRES_DB=visitops
POSTGRES_USER=visitops
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://visitops:change-this-local-password@localhost:5432/visitops
# For SQLite (development):

# ---- Redis (Cache + Message Broker) ----
REDIS_URL=redis://localhost:6379/0

# ---- Google Calendar ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=bookingbot_session

# ---- AI Settings ----
MAX_TOKENS=4096
CONVERSATION_TIMEOUT_MINUTES=60
HOLD_DEFAULT_MINUTES=15
MAX_HOLD_EXTENSIONS=2
ASSIGNMENT_TIMEOUT_MINUTES=5
HITL_CONFIDENCE_THRESHOLD=0.8

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=ai20k_tXHy4aJ_AssGVPyUBioM-iWgTbI0Y1Wp
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
 
