# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- OpenRouter LLM Configuration ----
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_SITE_URL=https://bookingbot.example.com
OPENROUTER_SITE_NAME=BookingBot
# Model used by the supervisor and the agents. The :free endpoints are unreliable
# under load; keep a paid model here for demos and evaluation runs.
MODEL_NAME=openai/gpt-4o-mini

# Fallback: OpenAI (if OpenRouter fails)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_NAME=gpt-4o-mini

# ---- Database ----
POSTGRES_DB=visitops
POSTGRES_USER=visitops
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://visitops:change-this-local-password@localhost:5432/visitops
# For SQLite (development):

# ---- Redis (Cache + Message Broker) ----
REDIS_URL=redis://localhost:6379/0

# ---- Google Calendar ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=bookingbot_session
PASSWORD_RESET_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:3005

# ---- Transactional email (required for password reset in production) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
ZALO_OA_URL=https://openapi.zalo.me/v3.0/oa/message/cs
ZALO_OA_TOKEN=
REMINDER_HOURS_BEFORE=24,2

# ---- Goong Maps: Geocoding, Distance Matrix, Nearby Search ----
# Lay key tai https://account.goong.io. Khong co key thi toan bo tinh nang
# khoang cach / tuyen duong tat im lang (GeoService.configured == False).
GOONG_API_KEY=
GEO_GEOCODE_CACHE_TTL_SECONDS=86400
GEO_ROUTE_CACHE_TTL_SECONDS=900
GEO_TIMEOUT_SECONDS=12
GEO_TRAFFIC_AWARE=true

# ---- AI Settings ----
MAX_TOKENS=4096
CONVERSATION_TIMEOUT_MINUTES=60
HOLD_DEFAULT_MINUTES=15
MAX_HOLD_EXTENSIONS=2
ASSIGNMENT_TIMEOUT_MINUTES=5
HITL_CONFIDENCE_THRESHOLD=0.8

# ---- Tracing ----
# LangSmith and Langfuse both trace every LLM call. Enable ONE at a time —
# running both doubles the per-turn tracing overhead.

# LangSmith (AI Logs — Deliverable #4). Set LANGCHAIN_TRACING_V2=true only with a real key.
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# Langfuse — the graph reads these keys and attaches the callback in src/agents/graph.py.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# Browser requests stay on /api/v1; Next.js proxies them to this backend origin.
# Set this on Vercel to https://bookingbot-api-q0t9.onrender.com
# BACKEND_INTERNAL_URL=http://localhost:8000
 
